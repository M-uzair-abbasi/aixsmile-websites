{
  "outputDirectory": ".",
  "buildCommand": "node build-en.mjs",
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.veneers-aachen.de" }],
      "destination": "https://veneers-aachen.de/$1",
      "permanent": true
    },
    { "source": "/en", "destination": "/en/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    { "source": "/js/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    {
      "source": "/(.*)\\.md",
      "headers": [{ "key": "Content-Type", "value": "text/markdown; charset=utf-8" }]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "</about.md>; rel=\"alternate\"; type=\"text/markdown\", </llms.txt>; rel=\"describedby\"; type=\"text/plain\""
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/termine.md", "destination": "https://aixsmile.de/termin.md?service=veneers" }
  ]
}
